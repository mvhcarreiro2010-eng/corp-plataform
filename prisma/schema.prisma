generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIOS E AUTENTICAÇÃO
// ============================================================

model BusinessUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  region    String?
  users     User[]
  createdAt DateTime @default(now())

  @@map("business_units")
}

model Turma {
  id        String      @id @default(cuid())
  name      String
  descricao String?
  users     TurmaUser[]
  createdAt DateTime    @default(now())

  @@map("turmas")
}

model TurmaUser {
  turmaId   String
  turma     Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([turmaId, userId])
  @@map("turma_users")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  avatar        String?
  role          Role     @default(EMPLOYEE)
  department    String?
  jobTitle      String?
  bio           String?
  matricula     String?  @unique
  cpf           String?  @unique
  regiao        String?
  admissaoEm    DateTime?
  ativo         Boolean  @default(true)
  xp            Int      @default(0)
  level         Int      @default(1)
  mustChangePassword Boolean  @default(false)
  lastLoginAt   DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buId          String?
  bu            BusinessUnit? @relation(fields: [buId], references: [id])

  coordenadorId String?
  coordenador   User?   @relation("UserCoordenador", fields: [coordenadorId], references: [id])
  coordenados   User[]  @relation("UserCoordenador")

  liderId       String?
  lider         User?   @relation("UserLider", fields: [liderId], references: [id])
  liderados     User[]  @relation("UserLider")

  instrutorId   String?
  instrutor     User?   @relation("UserInstrutor", fields: [instrutorId], references: [id])
  alunos        User[]  @relation("UserInstrutor")

  posts             Post[]
  comments          Comment[]
  likes             Like[]
  messages          Message[]
  channelMember     ChannelMember[]
  progress          Progress[]
  badges            UserBadge[]
  inductionProgress InductionProgress[]
  notifications     Notification[]
  tentativas        Tentativa[]
  turmas            TurmaUser[]
  presencas         TreinamentoPresenca[]
  resgates          Resgate[]
  comunicados       Comunicado[]        @relation("ComunicadoAuthor")
  comunicadoAceites ComunicadoAceite[]
  humorCheckIns     HumorCheckIn[]
  wikiViews         WikiPageView[]
  postViews         PostView[]

  @@map("users")
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
  COORDINATOR
  LEADER
  INSTRUCTOR
  EDITOR
}

// ============================================================
// FEED SOCIAL
// ============================================================

model Post {
  id         String     @id @default(cuid())
  content    String     @db.Text
  mediaUrl   String?
  mediaType  String?
  pinned     Boolean    @default(false)
  buIds      String[]   @default([])
  roleFilter String[]   @default([])
  userIds    String[]   @default([])
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]
  postViews  PostView[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("posts")
}

model PostView {
  userId   String
  postId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([userId, postId])
  @@map("post_views")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("likes")
}

// ============================================================
// WIKI DE CONHECIMENTO
// ============================================================

model WikiCategory {
  id       String         @id @default(cuid())
  name     String
  slug     String         @unique
  icon     String?
  color    String?
  parentId String?
  parent   WikiCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children WikiCategory[] @relation("CategoryTree")
  pages    WikiPage[]
  order    Int            @default(0)

  @@map("wiki_categories")
}

model WikiPage {
  id         String         @id @default(cuid())
  title      String
  slug       String         @unique
  content    String         @db.Text
  excerpt    String?
  pdfUrl     String?
  pdfName    String?
  categoryId String
  category   WikiCategory   @relation(fields: [categoryId], references: [id])
  authorId   String
  published  Boolean        @default(true)
  views      Int            @default(0)
  tags       String[]       @default([])
  buIds      String[]       @default([])
  roleFilter String[]       @default([])
  userIds    String[]       @default([])
  updatedAt  DateTime       @updatedAt
  createdAt  DateTime       @default(now())
  pageViews  WikiPageView[]

  @@map("wiki_pages")
}

// ============================================================
// COMUNIDADE (CHAT)
// ============================================================

model Channel {
  id          String          @id @default(cuid())
  name        String
  description String?
  type        ChannelType     @default(PUBLIC)
  icon        String?
  messages    Message[]
  members     ChannelMember[]
  createdAt   DateTime        @default(now())

  @@map("channels")
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([channelId, userId])
  @@map("channel_members")
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  mediaUrl  String?
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("messages")
}

// ============================================================
// E-LEARNING
// ============================================================

model Course {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  thumbnail   String?
  xpReward    Int        @default(100)
  published   Boolean    @default(false)
  tags        String[]   @default([])
  buIds       String[]   @default([])
  roleFilter  String[]   @default([])
  userIds     String[]   @default([])
  modules     Module[]
  progress    Progress[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("courses")
}

model Module {
  id       String   @id @default(cuid())
  title    String
  order    Int      @default(0)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@map("modules")
}

model Lesson {
  id        String     @id @default(cuid())
  title     String
  content   String?    @db.Text
  videoUrl  String?
  scormPath String?
  type      LessonType @default(TEXT)
  order     Int        @default(0)
  xpReward  Int        @default(20)
  duration  Int?
  moduleId  String
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  Progress[]
  quizzes   Quiz[]

  @@map("lessons")
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  PDF
  SCORM
}

model Quiz {
  id       String   @id @default(cuid())
  question String   @db.Text
  options  String[]
  answer   Int
  lessonId String
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  score       Int?
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@map("progress")
}

// ============================================================
// GAMIFICAÇÃO
// ============================================================

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  icon        String
  condition   String
  xpRequired  Int?
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ============================================================
// INDUÇÃO (ONBOARDING - ESTILO DUOLINGO)
// ============================================================

model InductionTrail {
  id          String          @id @default(cuid())
  title       String
  description String?
  published   Boolean         @default(false)
  buIds       String[]        @default([])
  roleFilter  String[]        @default([])
  userIds     String[]        @default([])
  steps       InductionStep[]
  createdAt   DateTime        @default(now())

  @@map("induction_trails")
}

model InductionStep {
  id               String              @id @default(cuid())
  title            String
  content          String              @db.Text
  type             StepType            @default(LESSON)
  order            Int                 @default(0)
  xpReward         Int                 @default(50)
  mediaUrl         String?
  // Se definido, o step só fica disponível N dias após admissaoEm do usuário
  diasDesbloquear  Int?
  // URL de redirecionamento para marcos (treinamento/avaliação externa)
  conteudoUrl      String?
  trailId          String
  trail            InductionTrail      @relation(fields: [trailId], references: [id], onDelete: Cascade)
  progress         InductionProgress[]
  quizzes          InductionQuiz[]

  @@map("induction_steps")
}

enum StepType {
  LESSON
  QUIZ
  VIDEO
  TASK
  MILESTONE
}

model InductionQuiz {
  id       String        @id @default(cuid())
  question String        @db.Text
  options  String[]
  answer   Int
  stepId   String
  step     InductionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("induction_quizzes")
}

model InductionProgress {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepId      String
  step        InductionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completed   Boolean       @default(false)
  score       Int?
  completedAt DateTime?

  @@unique([userId, stepId])
  @@map("induction_progress")
}

// ============================================================
// TREINAMENTOS ONLINE
// ============================================================

model TreinamentoOnline {
  id           String                @id @default(cuid())
  title        String
  description  String?               @db.Text
  url          String
  type         TreinamentoType       @default(YOUTUBE)
  scheduledAt  DateTime?
  duracao      Int?                  // minutos estimados
  published    Boolean               @default(false)
  turmaIds     String[]              @default([])
  roleFilter   String[]              @default([])
  presencas    TreinamentoPresenca[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("treinamentos_online")
}

enum TreinamentoType {
  YOUTUBE
  TEAMS
  OUTROS
}

model TreinamentoPresenca {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  treinamentoId   String
  treinamento     TreinamentoOnline @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  clicou          Boolean           @default(false)
  clicadoEm       DateTime?
  xpCreditado     Boolean           @default(false)

  @@unique([userId, treinamentoId])
  @@map("treinamento_presencas")
}

// ============================================================
// AVALIAÇÕES
// ============================================================

model Avaliacao {
  id              String      @id @default(cuid())
  title           String
  description     String?     @db.Text
  questoesExibir  Int         @default(10)
  tempoPorQuestao Int?
  tempoTotal      Int?
  maxTentativas   Int         @default(1)
  testeRapido     Boolean     @default(false)
  published       Boolean     @default(false)
  tags            String[]    @default([])
  buIds           String[]    @default([])
  roleFilter      String[]    @default([])
  userIds         String[]    @default([])
  questoes        Questao[]
  tentativas      Tentativa[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("avaliacoes")
}

enum TipoQuestao {
  MULTIPLA_ESCOLHA
  VERDADEIRO_FALSO
  MULTIPLA_RESPOSTA
  TEXTO_LIVRE
}

model Questao {
  id          String      @id @default(cuid())
  tipo        TipoQuestao @default(MULTIPLA_ESCOLHA)
  enunciado   String      @db.Text
  options     String[]    @default([])
  answer      Int         @default(0)
  answers     Int[]       @default([])
  gabarito    String?
  ordem       Int         @default(0)
  avaliacaoId String
  avaliacao   Avaliacao   @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@map("questoes")
}

model Tentativa {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avaliacaoId     String
  avaliacao       Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  respostas       Json      @default("{}")
  questoesIds     String[]  @default([])
  nota            Float?
  acertos         Int?
  fechadaPorTrapa Boolean   @default(false)
  iniciadaEm      DateTime  @default(now())
  finalizadaEm    DateTime?

  @@map("tentativas")
}

// ============================================================
// LOJA DE PONTOS (XP)
// ============================================================

model LojaItem {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  imageUrl    String?
  xpCusto     Int
  estoque     Int       @default(-1) // -1 = ilimitado
  ativo       Boolean   @default(true)
  resgates    Resgate[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("loja_itens")
}

model Resgate {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       LojaItem      @relation(fields: [itemId], references: [id])
  xpDebitado Int
  status     ResgateStatus @default(PENDENTE)
  createdAt  DateTime      @default(now())

  @@map("resgates")
}

enum ResgateStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

// ============================================================
// COMUNICADOS URGENTES
// ============================================================

model Comunicado {
  id            String             @id @default(cuid())
  title         String
  content       String             @db.Text
  urgente       Boolean            @default(false)
  requireAceite Boolean            @default(false)
  buIds         String[]           @default([])
  roleFilter    String[]           @default([])
  published     Boolean            @default(false)
  authorId      String
  author        User               @relation("ComunicadoAuthor", fields: [authorId], references: [id])
  aceites       ComunicadoAceite[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("comunicados")
}

model ComunicadoAceite {
  comunicadoId String
  userId       String
  aceitadoEm  DateTime   @default(now())
  comunicado  Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([comunicadoId, userId])
  @@map("comunicado_aceites")
}

// ============================================================
// HUMOR DIÁRIO
// ============================================================

model HumorCheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  humor     Int      // 1=Péssimo 2=Ruim 3=Ok 4=Bom 5=Ótimo
  data      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@unique([userId, data])
  @@map("humor_checkins")
}

// ============================================================
// RASTREIO DE VISUALIZAÇÕES WIKI
// ============================================================

model WikiPageView {
  userId   String
  pageId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([userId, pageId])
  @@map("wiki_page_views")
}

// ============================================================
// NOTIFICAÇÕES
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}
